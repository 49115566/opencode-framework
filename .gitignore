# ---------------------------------------------------------------------------
# opencode-framework
# ---------------------------------------------------------------------------

# Workflow artifacts are working state, not source. One directory per feature
# lives under work/. Keep the directory itself so `work/` always exists.
work/*
!work/.gitkeep

# opencode local state (auto-generated when opencode runs; never ship these)
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock
.opencode/cache/
.opencode/state/

# ---------------------------------------------------------------------------
# Tooling output (created on demand; never commit)
# ---------------------------------------------------------------------------
.playwright-mcp/
scratch/

# ---------------------------------------------------------------------------
# Node / TypeScript
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.npm/
.pnpm-store/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
